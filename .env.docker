# адреса зависимостей внутри сети docker compose. перекрывают значения из .env,
# которые нужны для запуска с хоста.
NODE_ENV=production
LOG_PRETTY=false

DB_HOST=postgres
DB_PORT=5432
REDIS_HOST=redis
MONGO_HOST=mongo
MONGO_PORT=27017
KAFKA_BROKERS=kafka:29092
S3_ENDPOINT=http://minio:9000

LOG_LEVEL=info
DB_LOGGING=false