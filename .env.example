# Database
DB_HOST=localhost
DB_PORT=5433
DB_USER=app_user
DB_PASSWORD=very_hard_password
DB_NAME=backend_homeworks_db

DB_LOGGING=true

# App
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Rate limit
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_PERIOD=1m

# Jwt
JWT_ACCESS_SECRET=super_mega_unbelievable_secret_code
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# S3
S3_ENDPOINT=http://localhost:9000
S3_REGION=ru-central1
S3_ACCESS_KEY_ID=your_access_key
S3_SECRET_ACCESS_KEY=your_secret_key
S3_BUCKET=avatars
S3_PUBLIC_URL=http://localhost:9000/avatars

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=very_hard_redis_password

# Cache
USERS_CACHE_TTL=30s

# Wallet
IDEMPOTENCY_KEY_TTL=24h

# Balance reset
BALANCE_RESET_ENABLED=true
BALANCE_RESET_INTERVAL=10m
BALANCE_RESET_BATCH_SIZE=1000
BALANCE_RESET_DEDUP_TTL=5m

# Logging
LOG_LEVEL=debug
LOG_PRETTY=true
