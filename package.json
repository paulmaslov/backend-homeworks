{
    "name": "backend-homeworks",
    "version": "0.0.1",
    "description": "",
    "author": "",
    "private": true,
    "license": "UNLICENSED",
    "scripts": {
        "build": "nest build --all",
        "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
        "start:user:dev": "nest start user-service --watch",
        "start:user:debug": "nest start user-service --debug --watch",
        "start:user:prod": "node dist/apps/user-service/apps/user-service/src/main",
        "start:notification:dev": "nest start notification-service --watch",
        "start:notification:debug": "nest start notification-service --debug --watch",
        "start:notification:prod": "node dist/apps/notification-service/apps/notification-service/src/main",
        "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix --max-warnings=0",
        "typecheck": "tsc --noEmit",
        "test": "node --experimental-vm-modules --disable-warning=ExperimentalWarning node_modules/jest/bin/jest.js",
        "test:watch": "node --experimental-vm-modules --disable-warning=ExperimentalWarning node_modules/jest/bin/jest.js --watch",
        "test:cov": "node --experimental-vm-modules --disable-warning=ExperimentalWarning node_modules/jest/bin/jest.js --coverage",
        "test:debug": "node --experimental-vm-modules --disable-warning=ExperimentalWarning --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/jest/bin/jest.js --runInBand",
        "test:e2e": "node --experimental-vm-modules --disable-warning=ExperimentalWarning -r tsconfig-paths/register node_modules/jest/bin/jest.js --config ./apps/user-service/test/jest-e2e.json",
        "prepare": "husky",
        "pre-commit": "lint-staged && npm run typecheck",
        "migration:user:up": "ts-node -r tsconfig-paths/register apps/user-service/src/databases/migrate.ts up",
        "migration:user:down": "ts-node -r tsconfig-paths/register apps/user-service/src/databases/migrate.ts down",
        "migration:user:pending": "ts-node -r tsconfig-paths/register apps/user-service/src/databases/migrate.ts pending",
        "migration:user:create": "ts-node -r tsconfig-paths/register apps/user-service/src/databases/migrate.ts create --name",
        "migration:user:up:prod": "node dist/apps/user-service/apps/user-service/src/databases/migrate.js up",
        "migration:notification:up": "ts-node -r tsconfig-paths/register apps/notification-service/src/databases/migrate.ts up",
        "migration:notification:down": "ts-node -r tsconfig-paths/register apps/notification-service/src/databases/migrate.ts down",
        "migration:notification:pending": "ts-node -r tsconfig-paths/register apps/notification-service/src/databases/migrate.ts pending",
        "migration:notification:create": "ts-node -r tsconfig-paths/register apps/notification-service/src/databases/migrate.ts create --name",
        "migration:notification:up:prod": "node dist/apps/notification-service/apps/notification-service/src/databases/migrate.js up",
        "keys:cleanup": "ts-node -r tsconfig-paths/register apps/user-service/src/scripts/cleanup-idempotency-keys.ts",
        "keys:cleanup:prod": "node dist/apps/user-service/apps/user-service/src/scripts/cleanup-idempotency-keys.js"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.1093.0",
        "@keyv/redis": "^5.1.6",
        "@nestjs/bullmq": "^12.0.0",
        "@nestjs/cache-manager": "^12.0.1",
        "@nestjs/common": "^12.0.0",
        "@nestjs/config": "^12.0.0",
        "@nestjs/core": "^12.0.0",
        "@nestjs/jwt": "^12.0.3",
        "@nestjs/microservices": "^12.0.0",
        "@nestjs/mongoose": "^12.0.0",
        "@nestjs/platform-express": "^12.0.0",
        "@nestjs/platform-socket.io": "^12.0.0",
        "@nestjs/sequelize": "^12.0.0",
        "@nestjs/swagger": "^12.0.0",
        "@nestjs/terminus": "^12.1.0",
        "@nestjs/throttler": "^6.7.1",
        "@nestjs/websockets": "^12.0.0",
        "argon2": "^0.44.0",
        "bullmq": "^5.81.3",
        "cache-manager": "^7.2.9",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.15.1",
        "cookie-parser": "^1.4.7",
        "dotenv": "^17.4.2",
        "joi": "^18.2.3",
        "kafkajs": "^2.2.4",
        "mongoose": "^9.11.2",
        "ms": "^2.1.3",
        "nestjs-pino": "^5.3.1",
        "pg": "^8.22.0",
        "pg-hstore": "^2.3.4",
        "pino": "^10.3.1",
        "pino-http": "^11.0.0",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.1",
        "sequelize": "^6.37.8",
        "sequelize-typescript": "^2.1.6",
        "sharp": "^0.35.3",
        "socket.io": "^4.8.3",
        "umzug": "^3.8.3"
    },
    "devDependencies": {
        "@eslint/eslintrc": "^3.2.0",
        "@eslint/js": "^9.18.0",
        "@nestjs/cli": "^12.0.0",
        "@nestjs/schematics": "^12.0.0",
        "@nestjs/testing": "^12.0.0",
        "@testcontainers/minio": "^12.0.4",
        "@testcontainers/postgresql": "^12.0.4",
        "@testcontainers/redis": "^12.0.4",
        "@types/cookie-parser": "^1.4.10",
        "@types/express": "^5.0.0",
        "@types/jest": "^30.0.0",
        "@types/ms": "^2.1.0",
        "@types/multer": "^2.2.0",
        "@types/node": "^22.10.7",
        "@types/sequelize": "^4.28.20",
        "@types/supertest": "^6.0.2",
        "eslint": "^9.18.0",
        "eslint-config-prettier": "^10.0.1",
        "eslint-import-resolver-typescript": "^4.4.5",
        "eslint-plugin-import-x": "^4.17.1",
        "eslint-plugin-jest": "^28.14.0",
        "eslint-plugin-no-relative-import-paths": "^1.6.1",
        "eslint-plugin-prettier": "^5.2.2",
        "eslint-plugin-simple-import-sort": "^14.0.0",
        "globals": "^16.0.0",
        "husky": "^9.1.7",
        "jest": "^30.0.0",
        "lint-staged": "^17.1.1",
        "pino-pretty": "^13.1.3",
        "prettier": "^3.4.2",
        "source-map-support": "^0.5.21",
        "supertest": "^7.0.0",
        "testcontainers": "^12.0.4",
        "ts-jest": "^29.4.0",
        "ts-loader": "^9.5.2",
        "ts-node": "^10.9.2",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.20.0"
    },
    "overrides": {
        "@nestjs/swagger": {
            "js-yaml": "^5.4.3"
        },
        "sequelize": {
            "uuid": "^11.1.1"
        }
    },
    "jest": {
        "moduleFileExtensions": [
            "js",
            "json",
            "ts"
        ],
        "rootDir": ".",
        "testRegex": ".*\\.spec\\.ts$",
        "transform": {
            "^.+\\.(t|j)s$": "ts-jest"
        },
        "collectCoverageFrom": [
            "apps/*/src/**/*.ts",
            "libs/*/src/**/*.ts",
            "!**/*.spec.ts",
            "!**/*.module.ts",
            "!**/*.interface.ts",
            "!apps/*/src/main.ts",
            "!apps/user-service/src/databases/**",
            "!apps/user-service/src/scripts/**",
            "!**/testing/**"
        ],
        "coverageDirectory": "./coverage",
        "testEnvironment": "node",
        "moduleNameMapper": {
            "^@libs/common(|/.*)$": "<rootDir>/libs/common/src/$1",
            "^@libs/contracts(|/.*)$": "<rootDir>/libs/contracts/src/$1",
            "^@notification-service/(.*)$": "<rootDir>/apps/notification-service/src/$1",
            "^@user-service/(.*)$": "<rootDir>/apps/user-service/src/$1"
        },
        "roots": [
            "<rootDir>/apps/",
            "<rootDir>/libs/"
        ]
    },
    "lint-staged": {
        "*.{js,jsx,ts,tsx}": [
            "eslint --fix --max-warnings=0"
        ],
        "*.{json,js,ts,jsx,tsx,html}": [
            "prettier --write --ignore-unknown"
        ]
    }
}
