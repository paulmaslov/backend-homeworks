{
    "name": "backend-homeworks",
    "version": "0.0.1",
    "description": "",
    "author": "",
    "private": true,
    "license": "UNLICENSED",
    "scripts": {
        "build": "nest build --all",
        "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
        "start:user:dev": "nest start user-service --watch",
        "start:user:debug": "nest start user-service --debug --watch",
        "start:user:prod": "node dist/apps/user-service/apps/user-service/src/main",
        "start:notification:dev": "nest start notification-service --watch",
        "start:notification:debug": "nest start notification-service --debug --watch",
        "start:notification:prod": "node dist/apps/notification-service/apps/notification-service/src/main",
        "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix --max-warnings=0",
        "typecheck": "tsc --noEmit",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:cov": "jest --coverage",
        "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
        "test:e2e": "node -r tsconfig-paths/register node_modules/.bin/jest --config ./apps/user-service/test/jest-e2e.json",
        "prepare": "husky",
        "pre-commit": "lint-staged",
        "migration:up": "ts-node -r tsconfig-paths/register apps/user-service/src/databases/migrate.ts up",
        "migration:down": "ts-node -r tsconfig-paths/register apps/user-service/src/databases/migrate.ts down",
        "migration:pending": "ts-node -r tsconfig-paths/register apps/user-service/src/databases/migrate.ts pending",
        "migration:create": "ts-node -r tsconfig-paths/register apps/user-service/src/databases/migrate.ts create --name",
        "migration:up:prod": "node dist/apps/user-service/apps/user-service/src/databases/migrate.js up",
        "keys:cleanup": "ts-node -r tsconfig-paths/register apps/user-service/src/scripts/cleanup-idempotency-keys.ts",
        "keys:cleanup:prod": "node dist/apps/user-service/apps/user-service/src/scripts/cleanup-idempotency-keys.js"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.1093.0",
        "@keyv/redis": "^5.1.6",
        "@nestjs/bullmq": "^11.0.4",
        "@nestjs/cache-manager": "^3.1.3",
        "@nestjs/common": "^11.0.1",
        "@nestjs/config": "^4.0.4",
        "@nestjs/core": "^11.0.1",
        "@nestjs/jwt": "^11.0.2",
        "@nestjs/passport": "^11.0.5",
        "@nestjs/platform-express": "^11.0.1",
        "@nestjs/sequelize": "^11.0.1",
        "@nestjs/swagger": "^11.4.5",
        "@nestjs/throttler": "^6.5.0",
        "argon2": "^0.44.0",
        "bullmq": "^5.81.3",
        "cache-manager": "^7.2.9",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.15.1",
        "cookie-parser": "^1.4.7",
        "dotenv": "^17.4.2",
        "joi": "^18.2.3",
        "ms": "^2.1.3",
        "nestjs-pino": "^4.6.1",
        "passport": "^0.7.0",
        "passport-jwt": "^4.0.1",
        "pg": "^8.22.0",
        "pg-hstore": "^2.3.4",
        "pino": "^10.3.1",
        "pino-http": "^11.0.0",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.1",
        "sequelize": "^6.37.8",
        "sequelize-typescript": "^2.1.6",
        "sharp": "^0.35.3",
        "umzug": "^3.8.3"
    },
    "devDependencies": {
        "@eslint/eslintrc": "^3.2.0",
        "@eslint/js": "^9.18.0",
        "@nestjs/cli": "^11.0.0",
        "@nestjs/schematics": "^11.0.0",
        "@nestjs/testing": "^11.0.1",
        "@testcontainers/minio": "^12.0.4",
        "@testcontainers/postgresql": "^12.0.4",
        "@testcontainers/redis": "^12.0.4",
        "@types/cookie-parser": "^1.4.10",
        "@types/express": "^5.0.0",
        "@types/jest": "^29.5.14",
        "@types/ms": "^2.1.0",
        "@types/multer": "^2.2.0",
        "@types/node": "^22.10.7",
        "@types/passport-jwt": "^4.0.1",
        "@types/sequelize": "^4.28.20",
        "@types/supertest": "^6.0.2",
        "eslint": "^9.18.0",
        "eslint-config-prettier": "^10.0.1",
        "eslint-import-resolver-typescript": "^4.4.5",
        "eslint-plugin-import-x": "^4.17.1",
        "eslint-plugin-jest": "^28.14.0",
        "eslint-plugin-no-relative-import-paths": "^1.6.1",
        "eslint-plugin-prettier": "^5.2.2",
        "eslint-plugin-simple-import-sort": "^14.0.0",
        "globals": "^16.0.0",
        "husky": "^9.1.7",
        "jest": "^29.7.0",
        "lint-staged": "^17.1.1",
        "pino-pretty": "^13.1.3",
        "prettier": "^3.4.2",
        "source-map-support": "^0.5.21",
        "supertest": "^7.0.0",
        "testcontainers": "^12.0.4",
        "ts-jest": "^29.2.5",
        "ts-loader": "^9.5.2",
        "ts-node": "^10.9.2",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^5.7.3",
        "typescript-eslint": "^8.20.0"
    },
    "jest": {
        "moduleFileExtensions": [
            "js",
            "json",
            "ts"
        ],
        "rootDir": ".",
        "testRegex": ".*\\.spec\\.ts$",
        "transform": {
            "^.+\\.(t|j)s$": "ts-jest"
        },
        "collectCoverageFrom": [
            "apps/*/src/**/*.ts",
            "libs/*/src/**/*.ts",
            "!**/*.spec.ts",
            "!**/*.module.ts",
            "!**/*.interface.ts",
            "!apps/*/src/main.ts",
            "!apps/user-service/src/databases/**",
            "!apps/user-service/src/scripts/**",
            "!**/testing/**"
        ],
        "coverageDirectory": "./coverage",
        "testEnvironment": "node",
        "moduleNameMapper": {
            "^@libs/common(|/.*)$": "<rootDir>/libs/common/src/$1",
            "^@user-service/(.*)$": "<rootDir>/apps/user-service/src/$1"
        },
        "roots": [
            "<rootDir>/apps/",
            "<rootDir>/libs/"
        ]
    },
    "lint-staged": {
        "*.{js,jsx,ts,tsx}": [
            "eslint --fix --max-warnings=0"
        ],
        "*.{json,js,ts,jsx,tsx,html}": [
            "prettier --write --ignore-unknown"
        ]
    }
}
