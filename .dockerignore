# зависимости ставятся внутри образа, а в локальных лежат бинарники под локальную систему
node_modules
dist
coverage
**/coverage-e2e

# секреты не должны попасть в образ
.env
.env.*

.git
.idea
.postman
postman
*.log

# тесты в образ не идут, а их правки не должны сбрасывать кэш сборки
apps/*/test
**/*.spec.ts

# конфиги наблюдаемости в образе не нужны, а их правки не должны пересобирать приложение
docker